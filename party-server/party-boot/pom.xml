<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hongmai</groupId>
        <artifactId>party-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>party-boot</artifactId>
    <name>party-boot</name>
    <description>启动与装配：配置、过滤器、拦截器、切面、定时任务</description>

    <dependencies>
        <dependency>
            <groupId>com.hongmai</groupId>
            <artifactId>party-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hongmai</groupId>
            <artifactId>party-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hongmai</groupId>
            <artifactId>party-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hongmai</groupId>
            <artifactId>party-org</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hongmai</groupId>
            <artifactId>party-content</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hongmai</groupId>
            <artifactId>party-learn</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hongmai</groupId>
            <artifactId>party-exam</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
